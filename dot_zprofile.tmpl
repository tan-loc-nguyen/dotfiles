# Rendered by chezmoi from dot_zprofile.tmpl — edit the repo file, then `chezmoi apply`.
# Machine-specific PATHs are only written on machines where the folder exists.

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv zsh)"

export EDITOR=nvim
export VISUAL=nvim

# PATH. -U keeps entries unique: a shell started from another shell re-adds them all.
typeset -U path
export PATH="$HOME/.local/bin:$PATH"
{{- if stat (joinPath .chezmoi.homeDir ".docker/bin") }}
export PATH="$HOME/.docker/bin:$PATH"                         # Docker Desktop CLI
{{- end }}
# CocoaPods (gem on Homebrew Ruby). Found when the shell starts, so it works on the first
# login after bootstrap installs ruby, and after Ruby version bumps. (N) = skip if none.
for d in /opt/homebrew/lib/ruby/gems/*/bin(N); do export PATH="$d:$PATH"; done
{{- if stat (joinPath .chezmoi.homeDir "Library/Android/sdk") }}

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$PATH"
{{- end }}

# Claude Code
export CLAUDE_CODE_NO_FLICKER=1
