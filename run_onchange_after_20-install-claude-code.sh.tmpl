{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Installs Claude Code with its native installer (same method as the existing machine:
# ~/.local/bin/claude) — only when it isn't installed yet. Claude Code updates itself.
set -euo pipefail

if ! command -v claude >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/claude" ]; then
	curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}
