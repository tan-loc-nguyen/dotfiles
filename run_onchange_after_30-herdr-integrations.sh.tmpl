{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Installs herdr's agent-state integrations (hooks/plugins that tell herdr when an agent is
# working, blocked or done) for every agent CLI found on this machine.
# Agents found when this was rendered (a change here makes chezmoi re-run the script,
# so installing OpenCode later and running `chezmoi apply` picks it up):
#   claude:   {{ lookPath "claude" }}
#   opencode: {{ lookPath "opencode" }}
set -euo pipefail

command -v herdr >/dev/null 2>&1 || { echo "herdr not installed; skipping integrations"; exit 0; }

# Capture first: piping into `grep -q` would SIGPIPE herdr and fail under pipefail.
status="$(herdr integration status 2>&1)"

for agent in claude opencode; do
	command -v "$agent" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$agent" ] || continue
	if grep -q "^$agent: current" <<<"$status"; then
		continue
	fi
	herdr integration install "$agent"
done
{{ end -}}
