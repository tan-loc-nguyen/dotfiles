{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Points Claude Code's status line at the shared ~/.claude/statusline.sh.
# settings.json itself is NOT tracked (Claude Code and herdr rewrite it), so this merges
# the one key with jq and leaves every other setting untouched.
set -euo pipefail

settings="$HOME/.claude/settings.json"
command -v jq >/dev/null 2>&1 || { echo "jq not installed; skipping statusline setup"; exit 0; }

mkdir -p "$HOME/.claude"
[ -s "$settings" ] || echo '{}' >"$settings"

tmp="$(mktemp)"
jq '.statusLine = {"type": "command", "command": "~/.claude/statusline.sh"}' "$settings" >"$tmp"
mv "$tmp" "$settings"
{{ end -}}
